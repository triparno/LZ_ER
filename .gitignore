# ----------------------------------------------------------- scan intermediates
# run_scan24.sh writes one file per job before concatenating. Keep the merged
# scan24_results.txt; drop the per-seed pieces and logs.
scan/part_*.txt
scan/*.part
scan/*.log
scan/joblist*.txt
nohup.out

# ------------------------------------------------------- figures: what to keep
# Tracked:   the three PDFs used by the manuscript, in paper/
# Untracked: PNG previews and digitisation overlays, which regenerate in seconds
*.png
!spectra/*_check.png          # except the digitisation overlays, which are
                              # evidence that the traces match the source figures

